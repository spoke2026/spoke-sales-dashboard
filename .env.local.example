# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# HubSpot Service Key (from HubSpot Settings > Integrations > Service Keys)
HUBSPOT_API_KEY=pat-ap1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Supabase — per-person auth and targets (from Supabase Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Pipeline IDs (from your HubSpot account)
HUBSPOT_BESPOKE_PIPELINE_ID=1663955429
HUBSPOT_REVENUE_TRAIN_PIPELINE_ID=1691758052

# Deal stage IDs for "completed" deals in Bespoke Operations
HUBSPOT_GOODS_SHIPPED_STAGE_ID=2795435483
HUBSPOT_INVOICED_STAGE_ID=2795858407

# Marketing tab: Mailchimp sync (server only, never NEXT_PUBLIC_)
# Mailchimp: profile icon > Account & billing > Extras > API keys > Create A Key
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Supabase Settings > API > service_role key. Used only by the Mailchimp sync.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string. Vercel Cron sends it so only Vercel can start the weekly sync.
CRON_SECRET=a-long-random-string
